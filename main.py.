from sensor import Sensor
from controller import Controller
from test_cases import *

sensor = Sensor()
controller = Controller()

print("===== NORMAL TEST =====")

for value in normal_data:
    reading = sensor.get_reading(value)
    result = controller.process(reading, sensor.is_stuck())
    print(f"Distance: {reading} cm -> {result}")

